root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,shader,hlsl,cginc,compute}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,asmdef,asmref,uxml,uss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
