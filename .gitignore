# ==============================================================================
# Dead Reckoning - Unity 6 HDRP + Linux/Windows .gitignore
# ==============================================================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store & Addressables generated files
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Autogenerated IDE / C# project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated meta files for ignored debug/symbol files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated files on crash / diagnostics
sysinfo.txt
crash.dmp
*.stackdump

# Packaged builds & archives
*.apk
*.aab
*.unitypackage
*.app
*.x86_64

# IDE directories & editor backups
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS clutter (Linux / Windows / macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Source tool backup / temp files (Blender, DAWs, etc.)
*.blend1
*.blend2
*.blend@
*.rpp-bak
*.reapeaks
*_autosave*
